# Optional Gemini API Key (If omitted, local rule engine handles triage automatically)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct URI from Supabase)
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_postgres_connection_string

PORT=3001
